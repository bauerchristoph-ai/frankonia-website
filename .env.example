# FRANKONIA Website — Umgebungsvariablen
#
# Diese Datei ist die DOKUMENTATION der benötigten Variablen und wird
# eingecheckt. Die echten Werte gehören in `.env.local` (lokal, von
# `.gitignore` ausgeschlossen) und in Vercel → Settings → Environment
# Variables. Niemals Werte in diese Datei eintragen.
#
# ⚠️ ZWEI KATEGORIEN, und die Unterscheidung ist keine Formalität:
#
#   SERVER — landet ausschließlich in api/forms/submit.js, also auf dem
#            Server. Kommt nie in ein ausgeliefertes HTML.
#   ÖFFENTLICH — wird von build.js in das HTML geschrieben und steht damit
#            im Quelltext jeder Seite. Das ist bei diesen drei Werten
#            vorgesehen und unschädlich; sie sind trotzdem Variablen,
#            damit eine Testumgebung eigene Werte einsetzen kann.
#
# Fehlt eine ÖFFENTLICHE Variable, benutzt build.js den dokumentierten
# Produktionswert als Rückfall und schreibt eine Zeile ins Build-Log.
# Fehlt eine SERVER-Variable, verweigert der Endpoint den betroffenen
# Teilschritt und protokolliert das — er stürzt nicht ab, weil eine
# Anfrage nie verloren gehen darf.

# ---------------------------------------------------------------- SERVER
# HubSpot Private App Token (Portal 27143941, Datenhosting EU).
# Scopes: crm.objects.contacts.*, crm.objects.companies.*,
#         crm.objects.notes.*, crm.schemas.contacts.*
HUBSPOT_SERVICE_KEY=
HUBSPOT_PORTAL_ID=27143941

# Subscription-Typ "One to One" (Kommunikationseinstellungen). NUR für die
# Marketing-Einwilligung: erteilt jemand den Haken, wird die Einwilligung
# darauf mit Rechtsgrundlage gespeichert.
# ⚠️ Fehlt die Variable, wird KEINE ID geraten — der Endpoint
#    protokolliert es und lässt die Anfrage durch. Ohne den Eintrag ist die
#    Einwilligung im CRM aber nicht nachweisbar. Die ID auslesen mit:
#        HUBSPOT_SERVICE_KEY=… node scripts/setup-hubspot.mjs --verify
HUBSPOT_SUBSCRIPTION_ID_ONE_TO_ONE=

# Subscription-Typ „Marketing Information“ (Typ Marketing). Zweiter Empfänger
# derselben Einwilligung — Kundenentscheidung vom 26.08.2026 („einfach beides
# setzen“). One to One ist im Portal Typ Sales und deckt 1:1-Mails, dieser Typ
# deckt Kampagnen; der Haken im Formular verspricht Letzteres.
# ⚠️ Fehlt eine der beiden, wird die andere trotzdem gesetzt und die fehlende
#    protokolliert. Geraten wird nie.
HUBSPOT_SUBSCRIPTION_ID_MARKETING=

# Lifecycle-Phase, die eine Formularanfrage im CRM erhält — INTERNER Name, nicht
# das Label. ⚠️ Die beiden sind in HubSpot zwei verschiedene Dinge, und das
# Label ist pro Portal frei umbenennbar: in diesem Portal heißt der
# Standardname „lead“ nicht „Lead“, sondern „Termin vereinbart“. Der Code hat das
# bis zum 26.08.2026 fest geschrieben und hätte damit jede Anfrage mehrere
# Stufen zu weit einsortiert.
# ⚠️ NICHT GESETZT heißt: die Phase wird gar nicht geschrieben, HubSpot nimmt
#    seine eigene Voreinstellung. Das ist der einzige Wert, der in keinem Portal
#    falsch sein kann. Die Auswahl dieses Portals zeigt:
#        HUBSPOT_SERVICE_KEY=… node scripts/setup-hubspot.mjs --verify
HUBSPOT_LIFECYCLE_STAGE=

# Brevo API v3
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=
BREVO_CONFIRMATION_TEMPLATE_ID=

# Marketingliste. In Brevo trägt die LISTE die Einwilligung: wer in keiner
# Liste ist, kann keine Kampagne bekommen. Wird nur bei erteiltem Haken
# gesetzt — Transaktionsmails brauchen sie nicht.
# ⚠️ Fehlt die Variable, wird KEINE Listen-ID geraten. Eine falsche ID
#    würde jemanden in einen fremden Verteiler legen. IDs auslesen mit:
#        BREVO_API_KEY=… node scripts/setup-brevo.mjs
BREVO_MARKETING_LIST_ID=

# Interne Benachrichtigung bei jeder Anfrage
INTERNAL_NOTIFICATION_EMAIL=

# Cloudflare Turnstile — NUR der Secret. Er darf nie im Client landen.
TURNSTILE_SECRET_KEY=

# ----------------------------------------------------------- ÖFFENTLICH
# Turnstile Site Key. Steht ohnehin im HTML; als Variable, damit lokal
# Cloudflares Testschlüssel eingesetzt werden können
# (1x00000000000000000000AA = besteht immer,
#  2x00000000000000000000AB = schlägt immer fehl).
TURNSTILE_SITE_KEY=

# Cookiebot Domain-Gruppen-ID. Steht ohnehin im HTML.
COOKIEBOT_CBID=

# ⚠️ NUR DOKUMENTATION, wird NICHT ausgelesen. Der GTM-Loader läuft über
# den eigenen Tagging-Server d.frankonia-sicherheit.de, und die
# Container-ID steckt bereits in dessen Snippet in
# partials/head-common.html. Die Variable steht hier, damit klar ist,
# welcher Container gemeint ist.
GTM_CONTAINER_ID=GTM-NWLGMFJN
