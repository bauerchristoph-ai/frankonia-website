  "rewrites": [
    {
      "source": "/api/forms/submit/",
      "destination": "/api/forms/submit"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": ".*\\.vercel\\.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; script-src 'self' 'unsafe-inline' https://consent.cookiebot.com https://consentcdn.cookiebot.com https://d.frankonia-sicherheit.de https://challenges.cloudflare.com https://js-eu1.hsforms.net https://js.hsforms.net https://js-eu1.hs-scripts.com; style-src 'self' 'unsafe-inline' https://consentcdn.cookiebot.com https://js-eu1.hsforms.net; img-src 'self' data: https://*.basemaps.cartocdn.com https://imgsct.cookiebot.com https://d.frankonia-sicherheit.de https://*.hsforms.com https://track.hubspot.com; font-src 'self' data: https://js-eu1.hsforms.net; connect-src 'self' https://consent.cookiebot.com https://consentcdn.cookiebot.com https://d.frankonia-sicherheit.de https://challenges.cloudflare.com https://*.hsforms.com https://api-eu1.hubspot.com; frame-src 'self' https://challenges.cloudflare.com https://consentcdn.cookiebot.com https://d.frankonia-sicherheit.de https://*.hsforms.com https://*.hsforms.net; frame-ancestors 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    },
    {
      "source": "/assets/documents/(.*).vcf",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/vcard; charset=utf-8"
        }
      ]
    },
    {
      "source": "/css/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    },
    {
      "source": "/js/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600"
        }
      ]
    }
  ]
}
